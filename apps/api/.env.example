# VultStrike API Environment Configuration
# Copy this file to apps/api/.env and fill in your own values.

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://vultstrike:change-me-strong-password@localhost:5433/vultstrike?schema=public"

# =============================================================================
# SERVER
# =============================================================================
PORT=4000
NODE_ENV="development"

# =============================================================================
# PUBLIC URLS (customize for your deployment)
# =============================================================================
API_PUBLIC_URL="http://localhost:4000"
WEB_PUBLIC_URL="http://localhost:3000"

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_SECRET="change-me-please-32+chars-random"
JWT_ISSUER="vultstrike"
JWT_AUDIENCE="vultstrike-web"
JWT_EXPIRES_IN="1h"

# =============================================================================
# COOKIE CONFIGURATION
# =============================================================================
COOKIE_NAME="vultstrike_session"
COOKIE_SECRET="change-me-cookie-secret-32+chars"
# Local dev: leave empty. Production example: .example.com
COOKIE_DOMAIN=""
COOKIE_SECURE="false"

# =============================================================================
# STEAM AUTHENTICATION
# =============================================================================
# Get your Steam API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""
STEAM_AUTHKEY=""

# =============================================================================
# MATCH & WEBHOOK
# =============================================================================
MATCH_WEBHOOK_SECRET="change-me-webhook-secret"

# =============================================================================
# MATCHMAKER
# =============================================================================
MATCHMAKER_ENABLED="true"
REDIS_HOST="localhost"
REDIS_PORT="6380"
KAFKA_BROKERS="localhost:9092"

# =============================================================================
# CS2 SERVER CONFIGURATION
# =============================================================================
ORCHESTRATOR_PUBLIC_HOST="localhost"
CS2_GSLT=""
CS2_TARGET_WINS="13"

# Map pools (comma-separated)
CS2_MAP_POOL_ONE_V_ONE="tirgo,bluelines,newage"
CS2_MAP_POOL_TWO_V_TWO="de_dust2,de_mirage"
CS2_MAP_POOL_THREE_V_THREE="de_dust2,de_mirage"

# Set true to simulate flow without real CS2 containers
CS2_MOCK_MODE="true"
CS2_IMAGE="vultstrike-cs2:latest"
GAME_SERVER_HOST="127.0.0.1"

# Host path probes (used only when CS2_MOCK_MODE=false)
CS2_HOST_DIR="/absolute/path/to/Counter-Strike Global Offensive"
CS2_STEAMCMD_DIR="/absolute/path/to/steamcmd"
CS2_STEAM_RUNTIME_DIR="/absolute/path/to/Steam"
CS2_STEAM_DOT_DIR="/absolute/path/to/.steam"
CS2_STEAM_LIBRARY_CS2_DIR="/absolute/path/to/Counter-Strike Global Offensive"
CS2_LEGACY_STEAM_LIBRARY_CS2_DIR="/absolute/path/to/Counter-Strike Global Offensive"
CS2_LEGACY_HOST_DIR="/absolute/path/to/cs2"

# Optional explicit pool (e.g. "27015-35000" or "27015,27016,27017")
# Leave empty to use CS2_PORT_AUTO_MIN..CS2_PORT_AUTO_MAX
CS2_PORT_RANGE=""
CS2_PORT_AUTO_MIN="20000"
CS2_PORT_AUTO_MAX="32767"
CS2_PORT_ALLOCATE_ATTEMPTS="40"

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL="log"
