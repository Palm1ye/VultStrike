# VultStrike root environment (safe template)
# Copy to .env and fill your own values.

# -----------------------------
# Local DB (docker-compose.yml)
# -----------------------------
POSTGRES_USER=vultstrike
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vultstrike
DATABASE_URL=postgresql://vultstrike:change-me-strong-password@localhost:5433/vultstrike

# Optional local Redis URL (some workers may use this style)
REDIS_URL=redis://localhost:6380

# Optional external Redis (Upstash etc.)
UPSTASH_URL=
UPSTASH_TOKEN=
